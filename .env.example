# Set these in Vercel -> Project -> Settings -> Environment Variables (Production).
# Never commit real values. For local work, copy this file to .env.local.

# ---- Contact form (app/api/contact/route.ts), sends mail through Resend -----------------
# Required. Create at resend.com -> API Keys.
RESEND_API_KEY=

# Optional. Defaults shown. The "from" address must be on a domain verified in Resend.
CONTACT_TO_EMAIL=daviddoyle@summitinitiativesolutions.com
CONTACT_FROM_EMAIL="Summit Initiative Solutions <contact@summitinitiativesolutions.com>"

# ---- Blog editor at /admin (see "Blog and the editor" in the README) --------------------
# The editor stays switched off until all three of these are set.

# David's password for /admin. At least 12 characters; a long phrase is best.
ADMIN_PASSWORD=

# Random text for signing the login cookie. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# A fine-grained GitHub token for the repository with "Contents: Read and write".
BLOG_GITHUB_TOKEN=

# Optional. Defaults shown.
# BLOG_GITHUB_REPO=daviddoyle-dot/Summit_Intiative_Solutions
# BLOG_GITHUB_BRANCH=main
