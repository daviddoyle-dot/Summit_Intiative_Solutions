# Contact form (app/api/contact/route.ts) sends mail through Resend.
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Required. Create at resend.com -> API Keys.
RESEND_API_KEY=

# Optional. Defaults shown. The "from" address must be on a domain
# verified in Resend (summitinitiativesolutions.com).
CONTACT_TO_EMAIL=daviddoyle@summitinitiativesolutions.com
CONTACT_FROM_EMAIL="Summit Initiative Solutions <contact@summitinitiativesolutions.com>"
